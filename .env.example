# Environment variables for Build 4 Atelier Quotation Maker
# Copy to .env.local for local development

# Neon pooled connection (required on Vercel)
# Important: include pgbouncer=true when using a -pooler host
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
